---
import BlogIndexView from '../../../views/BlogIndexView.astro';
import BlogPostView from '../../../views/BlogPostView.astro';
import { getPosts } from '../../../utils/blog';
import { blogBuilt } from '../../../constants/blog';

// One route for /blog and /blog/<slug>; with BLOG_MODE = 'off' no path is generated.
export async function getStaticPaths() {
  if (!blogBuilt) return [];
  const posts = await getPosts('ru');
  return [
    { params: { slug: undefined }, props: { post: undefined } },
    ...posts.map((post) => ({ params: { slug: post.slug }, props: { post } })),
  ];
}

const { post } = Astro.props;
---

{post ? <BlogPostView lang="ru" post={post} /> : <BlogIndexView lang="ru" />}
