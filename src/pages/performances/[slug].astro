---
import ProjectView from '../../views/ProjectView.astro';
import { performanceProjects } from '../../data/projects';

export function getStaticPaths() {
  return performanceProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<ProjectView lang="en" project={project} section="performances" />
