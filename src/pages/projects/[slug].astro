---
import ProjectView from '../../views/ProjectView.astro';
import { artworks } from '../../data/projects';

export function getStaticPaths() {
  return artworks.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectView lang="en" project={project} section="projects" />
