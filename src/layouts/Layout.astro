---
import HamburgerMenu from '../components/HamburgerMenu';
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio of sound engineer and sound designer Ivan Petrov. Professional audio work for film, advertising, and media." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="sound engineer, sound designer, audio, portfolio, sound design" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet"></noscript>
    <title>{title}</title>
  </head>
  <body>
    <HamburgerMenu client:load />
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background-color: #000000;
  }

  body {
    font-family: 'Source Code Pro', 'Monaco', 'Menlo', 'Courier New', monospace;
    background-color: #000000;
    color: #f5f5f5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
    font-weight: 400;
    margin: 0;
    padding: 0;
  }

  /* Кастомные стили для аудио плеера */
  audio {
    outline: none;
    width: 100%;
    height: 40px;
  }

  audio::-webkit-media-controls-panel {
    background-color: #1a1a1a;
    border-radius: 8px;
  }

  audio::-webkit-media-controls-play-button {
    background-color: #f5f5f5;
    border-radius: 50%;
  }

  audio::-webkit-media-controls-current-time-display,
  audio::-webkit-media-controls-time-remaining-display {
    font-family: 'Source Code Pro', monospace;
    font-size: 11px;
    color: #a0a0a0;
  }

  audio::-webkit-media-controls-timeline {
    background-color: #333333;
    border-radius: 2px;
  }

  audio::-webkit-media-controls-volume-slider {
    background-color: #333333;
  }

  a {
    color: #f5f5f5;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  a:hover {
    color: #ffffff;
    opacity: 0.8;
  }
</style>

