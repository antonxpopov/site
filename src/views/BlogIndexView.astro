---
import Layout from '../layouts/Layout.astro';
import { ui, localePath } from '../i18n/ui';
import { getPosts, formatDate } from '../utils/blog';
import { typo } from '../utils/typo';
import { withBase } from '../utils/paths';
import { blogPublic } from '../constants/blog';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const posts = await getPosts(lang);
---

<Layout title={t.titles.blog} lang={lang} noindex={!blogPublic}>
  <main id="main" class="min-h-screen bg-bg pt-12 pb-24 font-mono">
    <div class="container mx-auto px-5 md:px-8 max-w-container">
      <h1 class="text-2xl md:text-3xl font-semibold text-text mb-8">{t.nav.blog}</h1>
      {
        posts.length === 0 ? (
          <p class="text-body text-text-muted">{t.blog.empty}</p>
        ) : (
          <ul class="divide-thin hairline-t hairline-b border-border">
            {posts.map((post) => (
              <li>
                <a
                  href={withBase(localePath(lang, `/blog/${post.slug}`))}
                  class="block py-5 hover:text-text-muted"
                >
                  <time class="text-sm text-text-muted" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date, lang)}
                    {post.data.draft && ' · draft'}
                  </time>
                  <span class="mt-1 block text-lg text-text">{typo(post.data.title, lang)}</span>
                  {post.data.summary && (
                    <span class="mt-1 block text-body text-text-muted max-w-[65ch]">
                      {typo(post.data.summary, lang)}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</Layout>
