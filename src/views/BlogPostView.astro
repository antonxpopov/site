---
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { ui, localePath } from '../i18n/ui';
import { formatDate, type BlogPost } from '../utils/blog';
import { getProject } from '../data/projects';
import { getAsset } from '../utils/images';
import { typo } from '../utils/typo';
import { withBase } from '../utils/paths';
import { blogPublic } from '../constants/blog';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
  post: BlogPost;
}
const { lang, post } = Astro.props;
const t = ui[lang];
const { Content } = await render(post);
const title = typo(post.data.title, lang);
const cover = post.data.cover ? getAsset(post.data.cover) : undefined;
const project = post.data.project ? getProject(post.data.project) : undefined;
const projectSection = project?.category === 'performance' ? 'performances' : 'projects';
---

<Layout
  title={`${title} — ${t.name}`}
  description={post.data.summary}
  lang={lang}
  image={post.data.cover}
  noindex={!blogPublic}
>
  <main id="main" class="min-h-screen bg-bg pt-12 pb-24 font-mono">
    <article class="container mx-auto px-5 md:px-8 max-w-container">
      <a
        href={withBase(localePath(lang, '/blog'))}
        class="tap inline-block text-sm text-text-muted hover:text-text mb-10">← {t.nav.blog}</a
      >
      <header class="mb-8">
        <time class="text-sm text-text-muted" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date, lang)}
        </time>
        <h1 class="mt-2 text-2xl md:text-4xl font-semibold text-text">{title}</h1>
      </header>
      {
        cover && (
          <Picture
            src={cover}
            alt=""
            formats={['avif', 'webp']}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1000px) 936px, 100vw"
            class="w-full h-auto rounded-lg mb-10"
          />
        )
      }
      <div
        class="max-w-[65ch] text-body text-text-muted space-y-4 [&_h2]:text-xl [&_h2]:text-text [&_h2]:font-semibold [&_h2]:mt-10 [&_h3]:text-text [&_h3]:font-semibold [&_h3]:mt-8 [&_a]:text-text [&_a]:underline [&_a]:underline-offset-4 [&_strong]:text-text [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_blockquote]:border-l [&_blockquote]:border-border [&_blockquote]:pl-4 [&_img]:rounded-lg [&_img]:w-full [&_code]:text-text"
      >
        <Content />
      </div>
      {
        project && (
          <p class="mt-12 text-sm">
            <a
              href={withBase(localePath(lang, `/${projectSection}/${project.slug}`))}
              class="tap text-text underline underline-offset-4"
            >
              {t.blog.project}: {project.title} →
            </a>
          </p>
        )
      }
    </article>
  </main>
</Layout>
