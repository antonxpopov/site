---
import Layout from '../layouts/Layout.astro';
import EntryList from '../components/EntryList.astro';
import { artworks } from '../data/projects';
import { ui, localePath } from '../i18n/ui';
import { localizeProject } from '../i18n/localize';
import { withBase } from '../utils/paths';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const entries = [...artworks]
  .sort((a, b) => Number(b.year) - Number(a.year))
  .map((p) => {
    const text = localizeProject(p, lang);
    return {
      year: p.year ?? '',
      title: text.title,
      meta: text.format,
      href: withBase(localePath(lang, `/projects/${p.slug}`)),
      thumb: p.imageUrl,
    };
  });
---

<Layout title={t.titles.projects} lang={lang}>
  <main class="min-h-screen bg-bg pt-12 pb-24">
    <div class="container mx-auto px-6 md:px-8 max-w-container">
      <h1 class="text-2xl md:text-3xl font-semibold text-text mb-8 font-mono">{t.nav.projects}</h1>
      <EntryList entries={entries} />
    </div>
  </main>
</Layout>
