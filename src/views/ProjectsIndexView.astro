---
import Layout from '../layouts/Layout.astro';
import ProjectsList from '../components/ProjectsList.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<Layout title={t.titles.projects} lang={lang}>
  <main class="min-h-screen bg-bg pt-12 pb-24">
    <div class="container mx-auto px-6 md:px-8 max-w-container">
      <h1 class="text-2xl md:text-3xl font-semibold text-text mb-8 font-mono">{t.nav.projects}</h1>
      <ProjectsList lang={lang} />
    </div>
  </main>
</Layout>
