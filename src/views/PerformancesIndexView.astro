---
import Layout from '../layouts/Layout.astro';
import EntryList from '../components/EntryList.astro';
import { performances } from '../data/performances';
import { getProject } from '../data/projects';
import { ui, localePath } from '../i18n/ui';
import { localizePerformance } from '../i18n/localize';
import { withBase } from '../utils/paths';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const entries = performances.map((item) => {
  const text = localizePerformance(item, lang);
  const project = item.slug ? getProject(item.slug) : undefined;
  const section = project?.category === 'performance' ? 'performances' : 'projects';
  return {
    year: item.date,
    title: text.title,
    meta: [text.city, text.venue].filter(Boolean).join(' · ') || undefined,
    href: project ? withBase(localePath(lang, `/${section}/${project.slug}`)) : item.url,
    thumb: project?.imageUrl,
  };
});
---

<Layout title={t.titles.performances} lang={lang}>
  <main class="min-h-screen bg-bg pt-12 pb-24">
    <div class="container mx-auto px-6 md:px-8 max-w-container">
      <h1 class="text-2xl md:text-3xl font-semibold text-text mb-8 font-mono">
        {t.nav.performances}
      </h1>
      <EntryList entries={entries} />
    </div>
  </main>
</Layout>
