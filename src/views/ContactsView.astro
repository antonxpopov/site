---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// TODO: add Instagram / Telegram / Vimeo profile links if you want them here.
const contacts = [
  { label: t.contactLabels.email, text: 'snwglb@gmail.com', url: 'mailto:snwglb@gmail.com' },
  {
    label: t.contactLabels.bandcamp,
    text: 'antonpopov.bandcamp.com',
    url: 'https://antonpopov.bandcamp.com',
  },
  {
    label: t.contactLabels.mixcloud,
    text: 'mixcloud.com/snwglb',
    url: 'https://www.mixcloud.com/snwglb/',
  },
];
---

<Layout title={t.titles.contacts} lang={lang}>
  <main class="min-h-screen bg-bg pt-12 pb-24 font-mono">
    <div class="container mx-auto px-6 md:px-8 max-w-container">
      <h1 class="text-2xl md:text-3xl font-semibold text-text mb-8">{t.nav.contacts}</h1>
      <ul class="divide-y divide-border max-w-xl">
        {
          contacts.map((c) => (
            <li class="py-3 grid grid-cols-[6rem_1fr] gap-x-4 text-sm">
              <span class="text-text-muted">{c.label}</span>
              <a
                href={c.url}
                target={c.url.startsWith('mailto:') ? undefined : '_blank'}
                rel={c.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                class="text-text underline underline-offset-4 hover:text-text-muted"
              >
                {c.text}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</Layout>
