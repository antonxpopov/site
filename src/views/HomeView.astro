---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<Layout title={t.titles.home} lang={lang} overlay>
  <main class="min-h-[100svh] bg-bg font-mono flex items-center">
    <div class="container mx-auto px-6 md:px-8 max-w-container">
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-text">{t.name}</h1>
      <p class="text-lg md:text-xl text-text-muted mt-4">{t.tagline}</p>
    </div>
  </main>
</Layout>
