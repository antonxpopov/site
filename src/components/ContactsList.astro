---
import data from '../cms/contacts.json';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Contact rows are edited through Pages CMS (src/cms/contacts.json).
const contacts = data.items.map((c) => ({
  label: lang === 'ru' && c.label_ru ? c.label_ru : c.label_en,
  text: c.text,
  url: c.url,
}));
const isExternal = (url: string) => url.startsWith('http');
---

<ul class="divide-thin max-w-xl">
  {
    contacts.map((c) => (
      <li class="py-3 grid grid-cols-[6rem_1fr] gap-x-4 text-sm">
        <span class="text-text-muted">{c.label}</span>
        <a
          href={c.url}
          target={isExternal(c.url) ? '_blank' : undefined}
          rel={isExternal(c.url) ? 'noopener noreferrer' : undefined}
          class="tap text-text underline underline-offset-4 hover:text-text-muted"
        >
          {c.text}
        </a>
      </li>
    ))
  }
</ul>
