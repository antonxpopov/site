---
import { bio } from '../data/cv';
import { ui } from '../i18n/ui';
import { typo } from '../utils/typo';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
  /** Skip this many leading paragraphs (the hero hides the two short intro lines) */
  from?: number;
  /** Show only this many paragraphs (short version for the home hero) */
  count?: number;
  /** Show the CV download link */
  showCv?: boolean;
}
const { lang, from = 0, count, showCv = true } = Astro.props;
const t = ui[lang];
const paragraphs = bio[lang]
  .slice(from, count === undefined ? undefined : from + count)
  .map((p) => typo(p, lang));
const cvUrl =
  lang === 'ru'
    ? 'https://drive.google.com/open?id=1faPpIlcHb3q4Pj5JBJOKjqQPWPZriMiI'
    : 'https://drive.google.com/file/d/1h_vU0aFkpLtUzlAlI11S0bHoopUXG-Ec/view?usp=sharing';
---

<div>
  <div class="max-w-[65ch] space-y-4 text-body text-text-muted">
    {paragraphs.map((p, i) => <p class={from + i === 1 ? 'text-text' : ''}>{p}</p>)}
  </div>

  {
    showCv && (
      <p class="mt-6 text-sm">
        <a
          href={cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text underline underline-offset-4 hover:text-text-muted tap"
        >
          {t.downloadCv} ↓
        </a>
      </p>
    )
  }
</div>
