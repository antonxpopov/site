---
import { Picture } from 'astro:assets';
import { lectures } from '../data/lectures';
import { ui } from '../i18n/ui';
import { localizeLecture } from '../i18n/localize';
import { getAsset } from '../utils/images';
import type { Lang } from '../types';

interface Props {
  lang: Lang;
  /** Rendered under a section h2 (home page) rather than the page h1 */
  nested?: boolean;
}
const { lang, nested = false } = Astro.props;
const t = ui[lang];
const Title = nested ? 'h3' : 'h2';
---

<ul class="divide-y divide-border">
  {
    lectures.map((item) => {
      const text = localizeLecture(item, lang);
      return (
        <li class="py-8 grid grid-cols-[3rem_1fr] md:grid-cols-[5rem_1fr] gap-x-4">
          <span class="text-text-muted text-sm pt-1">{item.year}</span>
          <div class="max-w-3xl">
            <p class="text-text-muted text-sm">{t.kind[item.kind]}</p>
            <Title class="text-lg text-text mt-1">{text.title}</Title>
            <p class="text-text-muted text-sm mt-1 mb-4">{text.venue}</p>
            <div class="space-y-3 text-body text-text-muted max-w-[65ch]">
              {text.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            {item.images && item.images.length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5">
                {item.images.map(
                  (src) =>
                    getAsset(src) && (
                      <Picture
                        src={getAsset(src)!}
                        alt={text.title}
                        formats={['avif', 'webp']}
                        widths={[480, 800, 1200]}
                        sizes="(min-width: 640px) 480px, 100vw"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-auto rounded-lg"
                      />
                    )
                )}
              </div>
            )}
          </div>
        </li>
      );
    })
  }
</ul>
