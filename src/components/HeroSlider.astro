---
import { Picture } from 'astro:assets';
import { getAsset } from '../utils/images';

// Photos from content/about as a darkened, crossfading background for the home hero.
const slides = Array.from({ length: 8 }, (_, i) =>
  getAsset(`/images/about/popov_about_2026_${String(i + 1).padStart(2, '0')}.jpg`)
).filter((img) => !!img);
---

{
  slides.length > 0 && (
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true" data-hero-slider>
      {slides.map((img, i) => (
        <Picture
          src={img!}
          alt=""
          formats={['avif', 'webp']}
          widths={[960, 1600, 2400]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          class:list={[
            'absolute inset-0 w-full h-full object-cover transition-opacity duration-[2000ms] ease-in-out',
            i === 0 ? 'opacity-100' : 'opacity-0',
          ]}
          data-hero-slide
        />
      ))}
      <div class="absolute inset-0 bg-black/65" />
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-bg to-transparent" />
    </div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-hero-slider]');
  const slides = root ? [...root.querySelectorAll<HTMLElement>('[data-hero-slide]')] : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (slides.length > 1 && !reduce) {
    const INTERVAL_MS = 15000;
    let current = 0;
    const show = (next: number) => {
      slides[current].classList.replace('opacity-100', 'opacity-0');
      slides[next].classList.replace('opacity-0', 'opacity-100');
      current = next;
    };
    window.setInterval(() => {
      if (!document.hidden) show((current + 1) % slides.length);
    }, INTERVAL_MS);
  }
</script>
