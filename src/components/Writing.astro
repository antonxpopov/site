---
import { writing } from '../data/writing.ts';
---

<section id="writing" class="py-16 bg-bg">
  <div class="container mx-auto px-6 md:px-8 max-w-container w-full">
    <h2 class="text-2xl md:text-3xl font-medium text-text mb-8 text-center font-mono">Writing</h2>
    <ul class="max-w-3xl mx-auto divide-y divide-border font-mono">
      {
        writing.map((item) => (
          <li class="py-3 grid grid-cols-[4rem_1fr] md:grid-cols-[6rem_1fr] gap-x-4 text-base">
            <span class="text-text-muted">{item.year}</span>
            <span class="text-text">
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-4 hover:text-text-muted transition-colors"
                >
                  {item.title}
                </a>
              ) : (
                item.title
              )}
              {item.publication && (
                <span class="block text-text-muted text-sm">{item.publication}</span>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
