---
import { withBase } from '../utils/paths';
import { ui, localePath } from '../i18n/ui';
import { blogPublic } from '../constants/blog';
import type { Lang } from '../types';

interface Props {
  overlay?: boolean;
  lang: Lang;
  /** Current path without base and language prefix */
  neutralPath: string;
  /** Same page in each language (already with base) */
  alt: Record<Lang, string>;
}
const { overlay = false, lang, neutralPath, alt } = Astro.props;
const t = ui[lang];

const links = [
  { label: t.nav.about, href: '/about' },
  { label: t.nav.projects, href: '/projects' },
  { label: t.nav.teaching, href: '/teaching' },
  { label: t.nav.performances, href: '/performances' },
  { label: t.nav.contacts, href: '/contacts' },
  ...(blogPublic ? [{ label: t.nav.blog, href: '/blog' }] : []),
];

const isActive = (href: string) => neutralPath === href || neutralPath.startsWith(`${href}/`);
const langs: { code: Lang; label: string }[] = [
  { code: 'en', label: 'EN' },
  { code: 'ru', label: 'RU' },
];
---

<header
  class:list={[
    'top-0 inset-x-0 z-50 font-mono',
    overlay
      ? 'fixed hairline-b border-transparent transition-colors duration-200'
      : 'sticky bg-bg/90 backdrop-blur hairline-b border-border',
  ]}
  data-overlay={overlay ? '' : undefined}
>
  <div
    class="container mx-auto px-5 md:px-8 max-w-container h-16 flex items-center justify-between gap-6"
  >
    <!-- Language switch -->
    <div class="flex items-center gap-1 text-sm" role="group" aria-label={t.switchLabel}>
      {
        langs.map((l, i) => (
          <>
            {i > 0 && (
              <span class="text-border" aria-hidden="true">
                /
              </span>
            )}
            <a
              href={alt[l.code]}
              hreflang={l.code}
              lang={l.code}
              class:list={[
                'tap px-1',
                l.code === lang ? 'text-text font-semibold' : 'text-text-muted hover:text-text',
              ]}
              aria-current={l.code === lang ? 'true' : undefined}
            >
              {l.label}
            </a>
          </>
        ))
      }
    </div>

    <nav class="hidden md:flex gap-6 text-sm font-heading font-medium" aria-label={t.mainNav}>
      {
        links.map((l) => (
          <a
            href={withBase(localePath(lang, l.href))}
            class:list={[
              'hover:text-text',
              isActive(l.href) ? 'text-text underline underline-offset-8' : 'text-text-muted',
            ]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <details class="group md:hidden relative">
      <summary
        class="list-none [&::-webkit-details-marker]:hidden cursor-pointer text-text p-3 -m-3"
        aria-label={t.menu}
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <nav
        class="absolute right-0 top-9 w-60 bg-bg border border-border rounded-lg p-2 flex flex-col text-base font-heading font-medium"
        aria-label={t.mainNav}
      >
        {
          links.map((l) => (
            <a
              href={withBase(localePath(lang, l.href))}
              class:list={['py-3 px-3 rounded', isActive(l.href) ? 'text-text' : 'text-text-muted']}
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script>
  // Transparent over the hero, solid once the page is scrolled.
  const bar = document.querySelector<HTMLElement>('header[data-overlay]');
  if (bar) {
    const solid = ['bg-bg/90', 'backdrop-blur', 'border-border'];
    const update = () => {
      const on = window.scrollY > 40;
      solid.forEach((c) => bar.classList.toggle(c, on));
      bar.classList.toggle('border-transparent', !on);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<script>
  // Close the mobile <details> menu on outside click or Esc.
  const menu = document.querySelector<HTMLDetailsElement>('header details');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
