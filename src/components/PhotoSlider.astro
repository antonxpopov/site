---
import { Picture } from 'astro:assets';
import { ui } from '../i18n/ui';
import { getAsset } from '../utils/images';
import type { Lang } from '../types';

interface Props {
  /** Short image paths, e.g. '/images/projects/x/1.jpg' */
  images: string[];
  alt: string;
  lang: Lang;
  /** Photographer name(s) */
  credit?: string;
}
const { images, alt, lang, credit } = Astro.props;
const t = ui[lang].slider;
const photoLabel = ui[lang].photo;
const slides = images.map((src) => getAsset(src)).filter((s) => !!s);
const many = slides.length > 1;
---

{
  slides.length > 0 && (
    <section class="mb-10" aria-roledescription="carousel" aria-label={t.label} data-slider>
      <div class="relative group">
        <div
          class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden rounded-lg bg-bg-secondary"
          data-track
          tabindex="0"
        >
          {slides.map((img, i) => (
            <div
              class="shrink-0 w-full snap-center aspect-[3/2]"
              aria-roledescription="slide"
              aria-label={`${i + 1} / ${slides.length}`}
            >
              <Picture
                src={img!}
                alt={`${alt} — ${i + 1}`}
                formats={['avif', 'webp']}
                widths={[640, 960, 1280, 1800]}
                sizes="(min-width: 1064px) 1000px, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding={i === 0 ? 'sync' : 'async'}
                class="w-full h-full object-cover"
                pictureAttributes={{ class: 'block w-full h-full' }}
              />
            </div>
          ))}
        </div>

        {many && (
          <>
            <button
              type="button"
              data-prev
              aria-label={t.prev}
              class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/60 text-text flex items-center justify-center hover:bg-black/80 transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                />
              </svg>
            </button>
            <button
              type="button"
              data-next
              aria-label={t.next}
              class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/60 text-text flex items-center justify-center hover:bg-black/80 transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </button>
          </>
        )}
      </div>

      {(many || credit) && (
        <div class="mt-3 flex justify-between gap-4 text-sm text-text-muted">
          {many && (
            <p aria-live="polite">
              <span data-current>1</span> / {slides.length}
            </p>
          )}
          {credit && (
            <p class="ml-auto text-right">
              {photoLabel}: {credit}
            </p>
          )}
        </div>
      )}
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const current = root.querySelector<HTMLElement>('[data-current]');
    if (!track) return;

    const count = track.children.length;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const goTo = (i: number) =>
      track.scrollTo({
        left: ((i + count) % count) * track.clientWidth,
        behavior: reduce ? 'auto' : 'smooth',
      });
    const go = (dir: number) => {
      goTo(index() + dir);
      restart();
    };

    // Autoplay: one photo per AUTOPLAY_MS, looping. Paused while the visitor hovers,
    // focuses or touches the slider, while it is off-screen, or the tab is hidden.
    const AUTOPLAY_MS = 15000;
    let timer: number | undefined;
    let hovered = false;
    let focused = false;
    let visible = false;
    const stop = () => window.clearInterval(timer);
    function restart() {
      stop();
      if (count > 1 && visible && !hovered && !focused && !document.hidden) {
        timer = window.setInterval(() => goTo(index() + 1), AUTOPLAY_MS);
      }
    }
    root.addEventListener('mouseenter', () => ((hovered = true), restart()));
    root.addEventListener('mouseleave', () => ((hovered = false), restart()));
    root.addEventListener('focusin', () => ((focused = true), restart()));
    root.addEventListener('focusout', () => ((focused = false), restart()));
    track.addEventListener('touchstart', restart, { passive: true });
    document.addEventListener('visibilitychange', restart);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      restart();
    }).observe(root);

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(1));

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      }
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      }
    });

    track.addEventListener(
      'scroll',
      () => {
        if (current)
          current.textContent = String(Math.round(track.scrollLeft / track.clientWidth) + 1);
      },
      { passive: true }
    );
  });
</script>
